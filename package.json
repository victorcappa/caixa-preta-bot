{
  "name": "caixa-preta-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/require-port-3000.js && next dev --port 3000",
    "build": "next build",
    "start": "node scripts/require-port-3000.js && next start --port 3000",
    "lint": "eslint .",
    "test:host-mode": "node scripts/host-mode-simulation.js",
    "test:internet-voice": "node --no-warnings scripts/internet-voice-test.js",
    "test:internet-voice:live": "node --no-warnings --env-file-if-exists=.env.local scripts/internet-voice-live-evaluation.js",
    "test:games": "node --no-warnings scripts/game-director-test.js",
    "test:baralho-morbido": "node --no-warnings scripts/baralho-morbido-test.js",
    "test:instagram": "node --no-warnings scripts/instagram-controller-test.js",
    "test:suitcases": "node --no-warnings scripts/suitcase-director-test.js",
    "test:performance": "node --no-warnings scripts/performance-system-test.js",
    "test:scene-zero": "node --no-warnings scripts/scene-zero-test.js",
    "test:robot-sound": "node --no-warnings scripts/robot-sound-test.js",
    "test:robot-sound:browser": "node --no-warnings scripts/robot-sound-browser-test.js"
  },
  "dependencies": {
    "next": "^15.4.6",
    "openai": "^5.12.2",
    "playwright": "^1.62.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.6"
  }
}
